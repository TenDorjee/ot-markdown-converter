{
  "name": "ot-markdown-converter",
  "version": "1.0.0",
  "description": "Converts my.opentext.com knowledge articles to LLM-friendly Markdown",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "convert": "tsx src/cli/convert.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsx src/cli/check.ts",
    "dev": "tsx watch src/api/server.ts",
    "start": "tsx src/api/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TenDorjee/ot-markdown-converter.git"
  },
  "homepage": "https://github.com/TenDorjee/ot-markdown-converter#readme",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "js-yaml": "^5.5.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "hast-util-to-html": "^9.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
